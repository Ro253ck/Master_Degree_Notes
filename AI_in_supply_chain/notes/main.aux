\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Interaction between agent and environment in reinforcement learning. At each time step $t$, the agent receives an observation $O_t$ and a scalar reward $R_t$, then executes an action $A_t$. The environment, in turn, receives the action $A_t$ and emits the next observation $O_{t+1}$ along with the reward $R_{t+1}$. The time index $t$ increments at each environment step, resulting in a continuous cycle of perception, action, and feedback that drives the agent's learning process.\relax }}{6}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:rl_agent_environment}{{1.1}{6}{Interaction between agent and environment in reinforcement learning. At each time step $t$, the agent receives an observation $O_t$ and a scalar reward $R_t$, then executes an action $A_t$. The environment, in turn, receives the action $A_t$ and emits the next observation $O_{t+1}$ along with the reward $R_{t+1}$. The time index $t$ increments at each environment step, resulting in a continuous cycle of perception, action, and feedback that drives the agent's learning process.\relax }{figure.caption.2}{}}
